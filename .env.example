# 主服务在容器内部的数据库路径（挂载命名卷 noticechain-data）
NOTICECHAIN_DB=/data/noticechain.sqlite
# 样例站地址：容器内必须用服务名，不能用宿主机 localhost
SAMPLE_SITE_BASE=http://sample-site
# 样例站静态目录（本地直接 python 运行时的回退路径）
SAMPLE_SITE_DIR=./sample_site
# 评估日：清单按此日判断是否过期，固定日期保证结果可复算
EVAL_DATE=2026-11-15
# M8 下架与审计：HMAC 审计令牌密钥。只在服务端持有，用于签发/核验审计身份；
# 留空则进程启动生成一次性随机密钥（重启后旧令牌失效）。生产必须显式配置并保密。
NOTICECHAIN_AUDIT_SECRET=change-me-to-a-long-random-secret
